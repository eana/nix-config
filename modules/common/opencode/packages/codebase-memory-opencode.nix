{
  codebase-memory-mcp,
  stdenv,
}:

stdenv.mkDerivation {
  pname = "codebase-memory-opencode";
  inherit (codebase-memory-mcp) version;

  dontUnpack = true;
  strictDeps = true;

  installPhase = ''
    runHook preInstall

    export HOME="$TMPDIR/home"
    export XDG_CONFIG_HOME="$HOME/.config"
    mkdir -p "$XDG_CONFIG_HOME/opencode"

    ${codebase-memory-mcp}/bin/codebase-memory-mcp install \
      -y --force --skip-binary --clients=opencode

    # HACK: upstream always embeds ~/.local/bin in the generated plugin, even
    # with --skip-binary. Point it at the Nix store binary instead.
    # TODO: remove when upstream supports an explicit binary path.
    substituteInPlace "$XDG_CONFIG_HOME/opencode/plugins/cbm-augment.ts" \
      --replace-fail "$HOME/.local/bin/codebase-memory-mcp" \
      "${codebase-memory-mcp}/bin/codebase-memory-mcp"

    mkdir -p \
      "$out/share/opencode/skills" \
      "$out/share/opencode/agents" \
      "$out/share/opencode/plugins"

    cp -r "$XDG_CONFIG_HOME/opencode/skills/codebase-memory" \
      "$out/share/opencode/skills/"

    install -m644 "$XDG_CONFIG_HOME/opencode/agents/"codebase-memory*.md \
      "$out/share/opencode/agents/"
    install -m644 "$XDG_CONFIG_HOME/opencode/plugins/cbm-augment.ts" \
      "$out/share/opencode/plugins/"

    # The installer also writes opencode.json and AGENTS.md. Both are owned by
    # Home Manager here, so only the generated skill, agents, and plugin ship.
    chmod -R u=rwX,go=rX "$out/share/opencode"

    runHook postInstall
  '';

  meta = {
    description = "OpenCode skill, agent profiles, and plugin generated by codebase-memory-mcp";
    homepage = "https://github.com/DeusData/codebase-memory-mcp";
    license = codebase-memory-mcp.meta.license;
    platforms = codebase-memory-mcp.meta.platforms;
  };
}
